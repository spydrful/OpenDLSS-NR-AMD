# One line ending in the repository. Windows tools all read LF; the mix was accidental.
* text=auto eol=lf

# the Filament patch is applied byte for byte to an LF checkout: no line-ending conversion
*.patch -text

# Frozen measurement journals and tuning proofs contain byte-specific SHA-256
# identities. Preserve their recorded bytes across checkout and source archives.
docs/performance/**/*.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
